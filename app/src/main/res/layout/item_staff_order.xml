<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_staff_queue_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/kedebideri"
            android:text="A012"
            android:textColor="#FF8C38"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_staff_order_id"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/kedebideri"
            android:text="QE-20260330-A012"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/tv_staff_status"
            app:layout_constraintStart_toEndOf="@id/tv_staff_queue_num"
            app:layout_constraintTop_toTopOf="@id/tv_staff_queue_num" />

        <TextView
            android:id="@+id/tv_staff_items_summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/kedebideri"
            android:text="2x Chicken Adobo, 1x Iced Tea"
            android:textColor="#666666"
            android:textSize="12sp"
            app:layout_constraintEnd_toStartOf="@+id/tv_staff_status"
            app:layout_constraintStart_toStartOf="@id/tv_staff_order_id"
            app:layout_constraintTop_toBottomOf="@id/tv_staff_order_id" />

        <TextView
            android:id="@+id/tv_staff_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_selected"
            android:backgroundTint="#FF8C38"
            android:fontFamily="@font/kedebideri"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="WAITING"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_staff_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/kedebideri"
            android:text="Total: ₱195.00"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_staff_items_summary" />

        <!-- Staff Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tv_staff_total"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <Button
                android:id="@+id/btn_staff_call"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/bg_cream_button"
                android:fontFamily="@font/kedebideri"
                android:text="Call / Announce"
                android:textColor="#FF8C38"
                android:textSize="12sp"
                android:textAllCaps="false" />

            <View
                android:layout_width="8dp"
                android:layout_height="match_parent" />

            <Button
                android:id="@+id/btn_staff_collect"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/bg_orange_button"
                android:fontFamily="@font/kedebideri"
                android:text="Mark Collected"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textAllCaps="false" />

            <View
                android:layout_width="8dp"
                android:layout_height="match_parent" />

            <Button
                android:id="@+id/btn_staff_cancel"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_unselected"
                android:fontFamily="@font/kedebideri"
                android:text="Cancel"
                android:textColor="#E74C3C"
                android:textSize="12sp"
                android:textAllCaps="false" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>