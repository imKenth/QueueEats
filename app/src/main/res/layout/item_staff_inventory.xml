<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_inv_item_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/kedebideri"
            android:text="Chicken Adobo"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/switch_item_enabled"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_inv_item_price"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/kedebideri"
            android:text="₱85.00"
            android:textColor="#FF8C38"
            android:textSize="14sp"
            app:layout_constraintEnd_toStartOf="@+id/switch_item_enabled"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_inv_item_name" />

        <Switch
            android:id="@+id/switch_item_enabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="For Sale"
            android:fontFamily="@font/kedebideri"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="UseSwitchCompatOrMaterialXml" />

        <View
            android:id="@+id/divider_inv"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEEEEE"
            android:layout_marginVertical="10dp"
            app:layout_constraintTop_toBottomOf="@id/tv_inv_item_price" />

        <TextView
            android:id="@+id/tv_inv_stock_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/kedebideri"
            android:text="Current Stock:"
            android:textColor="#666666"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider_inv" />

        <TextView
            android:id="@+id/tv_inv_stock_qty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/kedebideri"
            android:text="15 servings"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/tv_inv_stock_label"
            app:layout_constraintStart_toEndOf="@+id/tv_inv_stock_label"
            app:layout_constraintTop_toTopOf="@+id/tv_inv_stock_label" />

        <Button
            android:id="@+id/btn_edit_stock"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_orange_button"
            android:fontFamily="@font/kedebideri"
            android:text="Edit / Adjust Stock"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textAllCaps="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider_inv" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>