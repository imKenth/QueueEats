<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Top Background Image -->
    <ImageView
        android:id="@+id/header_blur"
        android:layout_width="match_parent"
        android:layout_height="327dp"
        android:background="@drawable/blurimage"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <ImageView
        android:id="@+id/wave_bottom"
        android:layout_height="0dp"
        android:layout_width="match_parent"
        android:background="@drawable/rectangle2"
        android:translationY="251dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <ImageView
        android:id="@+id/wave_top"
        android:layout_height="0dp"
        android:layout_width="match_parent"
        android:background="@drawable/rectangle1"
        android:translationY="262dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <ImageView
        android:id="@+id/logo_bg"
        android:layout_width="189dp"
        android:layout_height="150dp"
        android:background="@drawable/bgoflogo"
        android:translationY="67dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <ImageView
        android:id="@+id/logo_main"
        android:layout_height="136dp"
        android:layout_width="204dp"
        android:background="@drawable/mylogo"
        android:translationY="65dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <TextView
        android:id="@+id/tagline_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tagline"
        android:textSize="11sp"
        android:textColor="@color/black"
        android:fontFamily="@font/kedebideri"
        android:translationY="194dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

</androidx.constraintlayout.widget.ConstraintLayout>